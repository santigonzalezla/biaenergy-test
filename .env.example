# ─── Postgres ───
POSTGRES_USER=bia
POSTGRES_PASSWORD=bia_secret
POSTGRES_DB=biaenergy
POSTGRES_PORT=5433

# ─── Backend ───
DATABASE_URL=postgres://bia:bia_secret@localhost:5433/biaenergy?sslmode=disable

APP_ENV=development
APP_TIMEZONE=America/Bogota
API_PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
# Servidor a servidor (no es CORS). Dentro de docker compose: http://ai-service:8000
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT=2m
# Token compartido backend ↔ servicio de IA para proteger POST /analyze (vacío = sin protección en local)
AI_SERVICE_TOKEN=
# Obligatorio en producción, mínimo 32 caracteres: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=12h

# ─── Seed ───
# Usuario administrador que crea el seed. Sin ADMIN_PASSWORD el seed no crea el admin
ADMIN_EMAIL=admin@bia.app
ADMIN_NAME=Admin BIA
# Mínimo 12 caracteres
ADMIN_PASSWORD=

# ─── AI service ───
# Railway inyecta PORT automáticamente; en local se usa este valor
PORT=8000
# Sin LLM_API_KEY el servicio redacta con plantillas deterministas
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
